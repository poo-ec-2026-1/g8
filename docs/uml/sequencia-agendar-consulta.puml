@startuml sequencia-agendar-consulta

' Agendar Consulta (Secretaria) — com.poo.controller.AgendamentoController

actor Secretaria
participant "AgendamentoController" as AC
participant "ConsultaRepository" as ConsultaRepo
participant "Consulta" as ConsultaModel

Secretaria -> AC : seleciona médico, paciente, data e horário
AC -> ConsultaRepo : loadAll()
ConsultaRepo --> AC : List<Consulta>
AC -> AC : verifica conflito\n(stream().anyMatch: mesma data + horário + médico)

alt conflito encontrado
  AC --> Secretaria : "Conflito de horário."
else sem conflito
  AC -> ConsultaModel : new Consulta(data, horario, medico, cliente)
  ConsultaModel -> ConsultaModel : valida horário (ValidadorUtils)
  AC -> ConsultaRepo : create(nova)
  ConsultaRepo -> ConsultaRepo : valida horário\n(isHorarioValido)
  ConsultaRepo --> AC : OK
  AC --> Secretaria : confirma agendamento
end

note right of AC
  Horário agora é validado nas DUAS camadas: no
  construtor de Consulta e na persistência
  (ConsultaRepository), espelhando o padrão de
  CPF/data já usado no ClienteRepository.
end note

@enduml
