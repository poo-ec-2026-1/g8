@startuml sequencia-cadastro-paciente

' Cadastrar Paciente (Secretaria) — com.poo.controller.CadastroController (aba Cliente)

actor Secretaria
participant "CadastroController" as CC
participant "Cliente" as ClienteModel
participant "ClienteRepository" as ClienteRepo
participant "CadastroValidator" as Validator

Secretaria -> CC : preenche nome, CPF e data de aniversário
CC -> ClienteModel : new Cliente(nome, CPF, aniversario)
ClienteModel -> ClienteModel : valida CPF e data (ValidadorUtils)

alt dados inválidos
  ClienteModel --> CC : IllegalArgumentException
  CC --> Secretaria : exibe mensagem de erro
else dados válidos
  CC -> ClienteRepo : create(cliente)
  ClienteRepo -> Validator : garantirCpfDisponivel(CPF)
  Validator -> Validator : existeComCpf em\nCliente/Medico/Secretaria
  Validator --> ClienteRepo : OK (CPF livre)
  ClienteRepo --> CC : OK
  CC --> Secretaria : confirma cadastro
end

note right of CC
  Unicidade GLOBAL de CPF: se o CPF já existir em
  qualquer tabela, garantirCpfDisponivel lança
  IllegalArgumentException e o cadastro é abortado.
end note

@enduml
